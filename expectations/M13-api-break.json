{
  "schema_version": "1.0",
  "scenario_id": "M13-api-break",
  "kind": "workflow",
  "scenario_path": "corpus/scenarios/governance/M13-api-break",
  "steps": [
    {
      "id": "establish_metrics_baseline",
      "fixture": "base",
      "use_work_copy": true,
      "cli": {
        "extra_args": [
          "--api-surface",
          "--update-metrics-baseline",
          "--metrics-baseline",
          "{work}/metrics-baseline.json"
        ]
      },
      "expect": {
        "exit_code": 0
      }
    },
    {
      "id": "detect_api_break",
      "fixture": "changed",
      "use_work_copy": true,
      "overlay": "changed",
      "cli": {
        "extra_args": [
          "--api-surface",
          "--metrics-baseline",
          "{work}/metrics-baseline.json",
          "--fail-on-api-break"
        ]
      },
      "expect": {
        "exit_code": 3
      }
    }
  ]
}
