{
  "schema_version": "1.0",
  "scenario_id": "D12-deferred-cycle-finding",
  "kind": "single_run",
  "scenario_path": "corpus/scenarios/detection/D12-deferred-cycle-finding",
  "cli": {
    "extra_args": ["--api-surface"]
  },
  "expect": {
    "exit_code": 0,
    "findings": {
      "exact_by_kind": {
        "deferred_cycle": 1,
        "import_cycle": 0
      },
      "must_include": [
        {"family": "design", "kind": "deferred_cycle", "severity": "warning"}
      ],
      "must_not_include": [
        {"family": "design", "kind": "import_cycle"}
      ]
    },
    "metrics": {
      "dependency_cycles": {
        "exact": 1
      }
    },
    "determinism": {
      "semantic_projection_stable": true
    }
  }
}
